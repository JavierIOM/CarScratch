---
import type { ScrapedExtras } from '../lib/types';

interface Props {
  extras: ScrapedExtras;
}

const { extras } = Astro.props;

// Check if we have any meaningful data to show
const hasPerformance = extras.bhp || extras.topSpeed || extras.zeroToSixty || extras.maxTorque;
const hasCompliance = extras.ulezCompliant !== undefined || extras.cazCompliant !== undefined || extras.insuranceGroup;
const hasMarket = extras.previousPrice || extras.previousMileage;
const hasFuelEconomy = extras.fuelEconomyUrban || extras.fuelEconomyExtraUrban || extras.fuelEconomyCombined;
const hasRoadTax = extras.roadTax12Month || extras.roadTax6Month;
const hasIoM = extras.previousUKRegistration || extras.dateOfFirstRegistrationIOM || extras.modelVariant || extras.category || extras.iomModel || extras.wheelPlan;
const hasAnyData = hasPerformance || hasCompliance || hasMarket || hasFuelEconomy || hasRoadTax || hasIoM || extras.bodyStyle || extras.transmission || extras.driveType || extras.registrationLocation;
---

{hasAnyData && (
  <div class="bg-slate-800/50 border border-slate-700">
    <div class="p-6 border-b border-slate-700">
      <h3 class="text-lg font-semibold">Additional Information</h3>
      {extras.sources && extras.sources.length > 0 && (
        <p class="text-sm text-slate-500 mt-1">
          Data from {extras.sources.join(', ')}
        </p>
      )}
    </div>

    <div class="p-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {/* Performance section */}
      {extras.bhp && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Power</dt>
          <dd class="font-medium">{extras.bhp} BHP</dd>
        </div>
      )}

      {extras.topSpeed && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Top Speed</dt>
          <dd class="font-medium">{extras.topSpeed}</dd>
        </div>
      )}

      {extras.zeroToSixty && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">0-60 MPH</dt>
          <dd class="font-medium">{extras.zeroToSixty}</dd>
        </div>
      )}

      {extras.maxTorque && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Max Torque</dt>
          <dd class="font-medium">{extras.maxTorque}</dd>
        </div>
      )}

      {/* Body & location */}
      {extras.bodyStyle && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Body Style</dt>
          <dd class="font-medium capitalize">{extras.bodyStyle.toLowerCase()}</dd>
        </div>
      )}

      {extras.transmission && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Transmission</dt>
          <dd class="font-medium capitalize">{extras.transmission.toLowerCase()}</dd>
        </div>
      )}

      {extras.driveType && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Drive Type</dt>
          <dd class="font-medium">{extras.driveType}</dd>
        </div>
      )}

      {extras.registrationLocation && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Registered In</dt>
          <dd class="font-medium">{extras.registrationLocation}</dd>
        </div>
      )}

      {/* Insurance & Compliance */}
      {extras.insuranceGroup && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Insurance Group</dt>
          <dd class="font-medium">{extras.insuranceGroup}</dd>
        </div>
      )}

      {extras.ulezCompliant !== undefined && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">ULEZ Compliant</dt>
          <dd class={`font-medium ${extras.ulezCompliant ? 'text-green-400' : 'text-red-400'}`}>
            {extras.ulezCompliant ? 'Yes' : 'No'}
          </dd>
        </div>
      )}

      {extras.cazCompliant !== undefined && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">CAZ Compliant</dt>
          <dd class={`font-medium ${extras.cazCompliant ? 'text-green-400' : 'text-red-400'}`}>
            {extras.cazCompliant ? 'Yes' : 'No'}
          </dd>
        </div>
      )}

      {/* Fuel economy */}
      {extras.fuelEconomyUrban && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">MPG (Urban)</dt>
          <dd class="font-medium">{extras.fuelEconomyUrban}</dd>
        </div>
      )}

      {extras.fuelEconomyExtraUrban && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">MPG (Extra Urban)</dt>
          <dd class="font-medium">{extras.fuelEconomyExtraUrban}</dd>
        </div>
      )}

      {extras.fuelEconomyCombined && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">MPG (Combined)</dt>
          <dd class="font-medium">{extras.fuelEconomyCombined}</dd>
        </div>
      )}

      {/* Road tax */}
      {extras.roadTax12Month && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Road Tax (12 months)</dt>
          <dd class="font-medium">{extras.roadTax12Month}</dd>
        </div>
      )}

      {extras.roadTax6Month && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Road Tax (6 months)</dt>
          <dd class="font-medium">{extras.roadTax6Month}</dd>
        </div>
      )}

      {/* Market data */}
      {extras.previousPrice && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Previously Advertised</dt>
          <dd class="font-medium text-amber-400">{extras.previousPrice}</dd>
        </div>
      )}

      {extras.previousMileage && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Advertised Mileage</dt>
          <dd class="font-medium">{extras.previousMileage} miles</dd>
        </div>
      )}

      {/* Isle of Man specific */}
      {extras.previousUKRegistration && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Previous UK Reg</dt>
          <dd class="font-medium">
            <a
              href={`/lookup/${extras.previousUKRegistration.replace(/\s/g, '')}`}
              class="text-amber-400 hover:text-amber-300 underline"
            >
              {extras.previousUKRegistration}
            </a>
          </dd>
        </div>
      )}

      {extras.dateOfFirstRegistrationIOM && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">IoM Registration Date</dt>
          <dd class="font-medium">{extras.dateOfFirstRegistrationIOM}</dd>
        </div>
      )}

      {extras.modelVariant && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Variant</dt>
          <dd class="font-medium">{extras.modelVariant}</dd>
        </div>
      )}

      {extras.category && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Category</dt>
          <dd class="font-medium">{
            { A: 'A - Motorcycle', B: 'B - Car', C: 'C - Goods Vehicle', D: 'D - Bus/Minibus' }[extras.category.toUpperCase()] || extras.category
          }</dd>
        </div>
      )}

      {extras.iomModel && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Model</dt>
          <dd class="font-medium">{extras.iomModel}</dd>
        </div>
      )}

      {extras.wheelPlan && (
        <div>
          <dt class="text-sm text-slate-500 mb-1">Wheel Plan</dt>
          <dd class="font-medium">{extras.wheelPlan}</dd>
        </div>
      )}
    </div>
  </div>
)}

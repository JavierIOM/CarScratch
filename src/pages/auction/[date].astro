---
import Layout from '../../layouts/Layout.astro';
import auctionData from '../../data/chrystals-auctions.json';
import { isManxPlate, formatManxPlateForDisplay } from '../../lib/iom-detector';
import { formatUKPlate } from '../../lib/plate-formatter';

const { date } = Astro.params;

if (!date) return Astro.redirect('/');

type Lot = { reg: string; desc: string; date: string; price: number | null };
const allLots = auctionData.lots as Lot[];

const lots = allLots.filter((lot) => lot.date === date);
if (lots.length === 0) return Astro.redirect('/');

const auctionDate = new Date(date + 'T00:00:00');
const today = new Date();
today.setHours(0, 0, 0, 0);
const auctionPast = auctionDate <= today;

const displayDate = auctionDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formatReg = (reg: string) => {
  const clean = reg.toUpperCase();
  if (isManxPlate(clean)) return formatManxPlateForDisplay(clean);
  return formatUKPlate(clean);
};

const cleanReg = (reg: string) => reg.toUpperCase().replace(/[\s-]/g, '');

const formatPrice = (price: number) =>
  new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 0 }).format(price);

const formatShortDate = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Build past appearances lookup: normalised reg → appearances on OTHER dates
const pastAppearances = new Map<string, { date: string; price: number | null; desc: string }[]>();
for (const lot of allLots) {
  if (lot.date === date) continue;
  const key = cleanReg(lot.reg);
  const existing = pastAppearances.get(key) ?? [];
  existing.push({ date: lot.date, price: lot.price, desc: lot.desc });
  pastAppearances.set(key, existing);
}

const auctionUrls = auctionData.auctionUrls as Record<string, string>;
const auctionUrl = auctionUrls[date] ?? null;

const soldCount = lots.filter((l) => l.price !== null).length;
---

<Layout
  title={`IOM Auction ${displayDate} — ${lots.length} Vehicles`}
  description={`Full vehicle listing for the Chrystals Auctions Isle of Man sale on ${displayDate}. ${lots.length} vehicles with MOT history, tax status, and mileage.`}
  canonicalPath={`/auction/${date}`}
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
      <p class="text-xs text-slate-500 mb-1 uppercase tracking-wider">Chrystals Auctions, Isle of Man</p>
      <h1 class="text-3xl font-bold mb-2">
        Auction — <span class="text-amber-400">{displayDate}</span>
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400">
        <span>{lots.length} vehicles</span>
        {auctionPast && soldCount > 0 && (
          <span class="text-green-400">{soldCount} sold</span>
        )}
        {auctionPast && soldCount === 0 && (
          <span class="text-slate-500">Results pending</span>
        )}
        {auctionUrl && (
          <>
            <span class="text-slate-600">|</span>
            <a
              href={auctionUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-400 hover:text-amber-300 transition-colors"
            >
              View on Easy Live Auction
            </a>
          </>
        )}
      </div>
      {!auctionPast && (
        <p class="text-xs text-slate-500 mt-3">
          History and status loads automatically as you scroll. Click <strong class="text-slate-400">Full History</strong> for complete MOT records and more.
        </p>
      )}
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap gap-3 mb-6 text-xs text-slate-400">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span> Taxed / MOT Valid</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span> SORN / MOT Expired</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span> Untaxed</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-500 inline-block"></span> No Data</span>
    </div>

    <!-- Vehicle grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" id="auction-grid">
      {lots.map((lot) => {
        const rawReg = lot.reg;
        const apiReg = cleanReg(rawReg);
        const displayRegText = formatReg(rawReg);
        const manx = isManxPlate(rawReg.toUpperCase());
        const lotMatch = lot.desc.match(/^Lot (\d+)/);
        const lotNum = lotMatch ? lotMatch[1] : null;
        const descText = lot.desc.replace(/^Lot \d+ - /, '');
        const past = pastAppearances.get(apiReg) ?? [];
        const sortedPast = [...past].sort((a, b) => b.date.localeCompare(a.date));

        return (
          <div
            class="vehicle-card bg-slate-800/50 border border-slate-700 p-4 flex flex-col gap-3 transition-colors"
            style={sortedPast.length > 0 ? 'border-color: rgb(185 28 28 / 0.6);' : ''}
            data-reg={apiReg}
          >
            <!-- Header row -->
            <div class="flex items-start justify-between gap-2">
              <div class="flex flex-col gap-1">
                {lotNum && (
                  <span class="text-xs text-slate-500">Lot {lotNum}</span>
                )}
                <div
                  class={`inline-flex items-center px-3 py-1 font-mono font-bold text-sm rounded ${
                    manx
                      ? 'bg-red-700/80 text-white border border-red-600'
                      : 'bg-amber-400 text-black'
                  }`}
                >
                  {displayRegText}
                  {manx && (
                    <span class="ml-2 text-xs font-normal opacity-70">IOM</span>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                {sortedPast.length > 0 && (
                  <span style="width:1.75rem;height:1.75rem;border-radius:9999px;background:#dc2626;color:white;font-weight:900;font-size:1.1rem;display:flex;align-items:center;justify-content:center;line-height:1;flex-shrink:0;" title={`Listed ${sortedPast.length} time(s) before`}>!</span>
                )}
                <a
                  href={`/lookup/${apiReg}`}
                  class="text-xs text-amber-400 hover:text-amber-300 border border-amber-600/40 px-2 py-1 hover:bg-amber-500/10 transition-colors whitespace-nowrap"
                >
                  Full History
                </a>
              </div>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-300 leading-snug">{descText}</p>

            <!-- Auction result (post-auction only) -->
            {auctionPast && (
              <div>
                {lot.price !== null ? (
                  <span class="inline-block px-2 py-0.5 bg-green-900/60 text-green-400 border border-green-700/50 text-sm font-semibold rounded">
                    Sold {formatPrice(lot.price)}
                  </span>
                ) : (
                  <span class="inline-block px-2 py-0.5 bg-slate-700 text-slate-400 text-sm rounded">
                    No sale
                  </span>
                )}
              </div>
            )}

            <!-- Past appearances -->
            {sortedPast.length > 0 && (
              <div class="mt-2 rounded border border-red-700/60 bg-red-900/20 p-2">
                <p class="text-xs text-red-400 font-semibold mb-1.5 uppercase tracking-wider">Previously listed</p>
                <ul class="flex flex-col gap-0.5">
                  {sortedPast.map((a) => (
                    <li class="text-xs flex items-center justify-between gap-2">
                      <span class="text-red-300">{formatShortDate(a.date)}</span>
                      {a.price !== null ? (
                        <span class="text-green-400 font-medium">{formatPrice(a.price)}</span>
                      ) : (
                        <span class="text-red-400/70">No sale</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Live status area (tax/MOT/mileage) -->
            <div class="status-area mt-auto">
              <div class="status-loading flex items-center gap-2 text-xs text-slate-500">
                <svg class="w-3 h-3 animate-spin flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                </svg>
                Loading status...
              </div>
              <div class="status-data hidden flex flex-wrap gap-2 text-xs"></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  function formatDate(dateStr: string): string {
    const padded = /^\d{4}-\d{2}$/.test(dateStr) ? dateStr + '-01' : dateStr;
    const d = new Date(padded + 'T00:00:00');
    if (isNaN(d.getTime())) return dateStr;
    const monthOnly = /^\d{4}-\d{2}$/.test(dateStr);
    return d.toLocaleDateString('en-GB', {
      ...(monthOnly ? {} : { day: 'numeric' }),
      month: 'short',
      year: 'numeric',
    });
  }

  function taxBadge(status: string | null, dueDate: string | null): string {
    if (!status) return `<span class="px-2 py-0.5 bg-slate-700 text-slate-400 rounded">Tax: No data</span>`;
    if (status === 'Taxed') {
      const due = dueDate ? ` until ${formatDate(dueDate)}` : '';
      return `<span class="px-2 py-0.5 bg-green-900/60 text-green-400 rounded border border-green-700/50">Taxed${due}</span>`;
    }
    if (status === 'SORN') {
      return `<span class="px-2 py-0.5 bg-red-900/60 text-red-400 rounded border border-red-700/50">SORN</span>`;
    }
    return `<span class="px-2 py-0.5 bg-amber-900/60 text-amber-400 rounded border border-amber-700/50">${status}</span>`;
  }

  function motBadge(status: string | null, dueDate: string | null): string {
    if (!status || status === 'No details held by DVLA') {
      return `<span class="px-2 py-0.5 bg-slate-700 text-slate-400 rounded">MOT: No data</span>`;
    }
    if (status === 'Valid') {
      const due = dueDate ? ` exp ${formatDate(dueDate)}` : '';
      return `<span class="px-2 py-0.5 bg-green-900/60 text-green-400 rounded border border-green-700/50">MOT${due}</span>`;
    }
    return `<span class="px-2 py-0.5 bg-red-900/60 text-red-400 rounded border border-red-700/50">MOT: ${status}</span>`;
  }

  function mileageBadge(mileage: number | null, unit: string | null): string {
    if (!mileage) return '';
    const formatted = mileage.toLocaleString('en-GB');
    const u = unit === 'km' ? 'km' : 'mi';
    return `<span class="px-2 py-0.5 bg-slate-700 text-slate-300 rounded">${formatted} ${u}</span>`;
  }

  async function loadVehicleStatus(card: HTMLElement) {
    const reg = card.dataset.reg;
    if (!reg) return;

    const loadingEl = card.querySelector('.status-loading') as HTMLElement | null;
    const dataEl = card.querySelector('.status-data') as HTMLElement | null;

    try {
      const res = await fetch(`/api/vehicle/${reg}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (loadingEl) loadingEl.classList.add('hidden');
      if (dataEl) {
        dataEl.classList.remove('hidden');
        const badges = [
          taxBadge(data.taxStatus, data.taxDueDate),
          motBadge(data.motStatus, data.motDueDate),
          mileageBadge(data.mileage, data.mileageUnit),
        ]
          .filter(Boolean)
          .join('');
        dataEl.innerHTML = badges || '<span class="text-slate-500">No data available</span>';
      }

      if (data.taxStatus === 'Taxed' && (data.motStatus === 'Valid' || !data.motStatus)) {
        card.style.borderColor = '';
        card.classList.replace('border-slate-700', 'border-green-700/40');
        if (!card.classList.contains('border-green-700/40')) card.style.borderColor = 'rgb(21 128 61 / 0.4)';
      } else if (data.taxStatus === 'SORN' || data.motStatus === 'Not valid') {
        card.style.borderColor = '';
        card.classList.replace('border-slate-700', 'border-red-700/40');
        if (!card.classList.contains('border-red-700/40')) card.style.borderColor = 'rgb(185 28 28 / 0.4)';
      } else {
        card.style.borderColor = '';
      }
    } catch {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (dataEl) {
        dataEl.classList.remove('hidden');
        dataEl.innerHTML = '<span class="text-slate-500">Status unavailable</span>';
      }
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          if (!card.dataset.loaded) {
            card.dataset.loaded = 'true';
            observer.unobserve(card);
            loadVehicleStatus(card);
          }
        }
      });
    },
    { rootMargin: '150px' }
  );

  document.querySelectorAll<HTMLElement>('.vehicle-card').forEach((card) => {
    observer.observe(card);
  });
</script>
